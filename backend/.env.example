# ═══════════════════════════════════════════════════════════════════════════
# MoneyMind Backend - Environment Variables
# ═══════════════════════════════════════════════════════════════════════════
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# ── App ──────────────────────────────────────────────────────────────────
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# ── CORS ─────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# ── Auth ─────────────────────────────────────────────────────────────────
# IMPORTANT: Generate a secure key for production:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ── Database ─────────────────────────────────────────────────────────────
# SQLite (development):
DATABASE_URL=sqlite+aiosqlite:///./moneymind.db
# PostgreSQL (production — uncomment and configure):
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/moneymind

# ── External APIs ────────────────────────────────────────────────────────
# Google Gemini API for LLM features (optional — falls back to heuristics)
GEMINI_API_KEY=

# Finnhub / Twelve Data API for live stock prices (optional — falls back to yfinance/seed)
STOCK_API_KEY=

# ── Rate Limiting ────────────────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=60

# ── File Uploads ─────────────────────────────────────────────────────────
MAX_UPLOAD_SIZE_MB=5
